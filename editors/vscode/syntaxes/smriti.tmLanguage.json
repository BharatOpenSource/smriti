{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Smriti",
  "scopeName": "source.smriti",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#arrow" },
    { "include": "#keyword-flow" },
    { "include": "#keyword-decl" },
    { "include": "#keyword-meta" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.hash.smriti",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.smriti",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.smriti", "match": "\\\\." }
      ]
    },
    "arrow": {
      "name": "keyword.operator.arrow.smriti",
      "match": "→|->|:"
    },
    "keyword-flow": {
      "name": "keyword.control.smriti",
      "match": "\\b(smriti|sutra|pravah|pada|vibhaga|niyama|anubhaga|anugama|aavaha|svasti|anaapta|sthiti)\\b"
    },
    "keyword-decl": {
      "name": "keyword.declaration.smriti",
      "match": "\\b(paksha|bhumika|adhikara|pramana|sangama|lagna|yuja|ghatana|vrtti|hetu|varna|khanda|pravritti|prativritti)\\b"
    },
    "keyword-meta": {
      "name": "keyword.other.smriti",
      "match": "\\b(adhipati|aavartana|stara|avadhi|prabhaava|sthala|kshetra|karta|kaarya|aagama|nirgama|samaya)\\b"
    },
    "type": {
      "name": "storage.type.smriti",
      "match": "\\b(sankhya|bhinnaanka|dashaamsha|vakya|tithi|antara|tarka|patra|krama|kosa|vikalpa)\\b"
    },
    "constant": {
      "name": "constant.language.smriti",
      "match": "\\b(satya|asatya|avyakta|public|restricted|private)\\b"
    },
    "number": {
      "name": "constant.numeric.smriti",
      "match": "\\b\\d+(\\.\\d+)*\\b"
    }
  }
}
