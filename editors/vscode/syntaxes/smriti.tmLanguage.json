{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Smriti",
  "scopeName": "source.smriti",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#property-key" },
    { "include": "#keyword-iti" },
    { "include": "#keyword-top" },
    { "include": "#keyword-flow" },
    { "include": "#keyword-terminal" },
    { "include": "#arrow" },
    { "include": "#colon" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.hash.smriti",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.smriti",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.smriti", "match": "\\\\." }
      ]
    },

    "property-key": {
      "comment": "Keywords that appear as property assignments — always followed by ':'",
      "name": "entity.other.attribute-name.smriti",
      "match": "\\b(adhipati|aavartana|stara|avadhi|prabhaava|sthala|kshetra|bhumika|adhikara|pramana|yuja|karta|kaarya|aagama|nirgama|samaya|khanda|pravritti|prativritti)\\b(?=\\s*:)"
    },

    "keyword-top": {
      "comment": "Top-level declarators — name a block or entity",
      "name": "entity.name.type.smriti",
      "match": "\\b(smriti|sutra|paksha|sangama|lagna|ghatana|vrtti|hetu|varna|anubhaga|anugama|aavaha)\\b"
    },

    "keyword-iti": {
      "comment": "iti — Pāṇinian named close marker",
      "name": "keyword.operator.iti.smriti",
      "match": "\\biti\\b"
    },

    "keyword-flow": {
      "comment": "Flow structure keywords — control the process path",
      "name": "keyword.control.smriti",
      "match": "\\b(pravah|pada|vibhaga|niyama)\\b"
    },

    "keyword-terminal": {
      "comment": "Terminal outcome keywords — end states of a process",
      "name": "support.function.smriti",
      "match": "\\b(svasti|anaapta|sthiti)\\b"
    },

    "arrow": {
      "name": "keyword.operator.arrow.smriti",
      "match": "→|->"
    },

    "colon": {
      "name": "punctuation.separator.key-value.smriti",
      "match": ":"
    },

    "type": {
      "comment": "Type names used in field declarations",
      "name": "storage.type.smriti",
      "match": "\\b(sankhya|bhinnaanka|dashaamsha|vakya|tithi|antara|tarka|patra|krama|kosa|vikalpa)\\b"
    },

    "constant": {
      "comment": "Literal values — tarka states and access levels",
      "name": "constant.language.smriti",
      "match": "\\b(satya|asatya|avyakta|public|restricted|private)\\b"
    },

    "number": {
      "name": "constant.numeric.smriti",
      "match": "\\b\\d+(\\.\\d+)*\\b"
    }
  }
}
