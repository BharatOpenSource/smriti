# Smriti Grammar Specification
# Version: 0.1
# This document is the language standard. The parser implements it.
# Notation: EBNF — ? = optional, * = zero or more, + = one or more, | = or

# ─── Top level ────────────────────────────────────────────────────────────────

smriti-file  ::= (smriti-decl | sutra-decl)*

smriti-decl  ::= "smriti" identifier "{" smriti-body "}"
sutra-decl   ::= "sutra"  identifier "{" sutra-body  "}"

smriti-body  ::= metadata* reference* participant* trigger? flow
sutra-body   ::= metadata* aagama-decl? flow nirgama-decl?

# ─── Metadata ─────────────────────────────────────────────────────────────────

metadata     ::= adhipati-decl
               | aavartana-decl
               | stara-decl
               | prabhaava-decl
               | sthala-decl
               | kshetra-decl
               | avadhi-decl

adhipati-decl   ::= "adhipati"  ":" string
aavartana-decl  ::= "aavartana" ":" version
stara-decl      ::= "stara"     ":" ("public" | "restricted" | "private")
prabhaava-decl  ::= "prabhaava" ":" date
sthala-decl     ::= "sthala"    ":" string
kshetra-decl    ::= "kshetra"   ":" string
avadhi-decl     ::= "avadhi"    ":" number "antara"

# ─── References ───────────────────────────────────────────────────────────────

reference    ::= sangama-decl | lagna-decl
sangama-decl ::= "sangama" identifier "{" "yuja" ":" string "}"
lagna-decl   ::= "lagna"   identifier "{" lagna-body "}"
lagna-body   ::= ("yuja" ":" string)
                 ("adhipati" ":" string)?
                 ("aavartana" ":" version)?

# ─── Participants ─────────────────────────────────────────────────────────────

participant      ::= "paksha" identifier "{" participant-body "}"
participant-body ::= bhumika-decl? adhikara-decl* pramana-decl?
bhumika-decl     ::= "bhumika"  ":" identifier
adhikara-decl    ::= "adhikara" ":" identifier ("," identifier)*
pramana-decl     ::= "pramana"  ":" string

# ─── Trigger ──────────────────────────────────────────────────────────────────

trigger      ::= "ghatana" "{" trigger-body+ "}"
trigger-body ::= vrtti-decl | hetu-decl
vrtti-decl   ::= "vrtti" ":" description
hetu-decl    ::= "hetu"  ":" description

# ─── Flow ─────────────────────────────────────────────────────────────────────

flow         ::= "pravah" "{" flow-item+ "}"
flow-item    ::= pada-decl
               | vibhaga-decl
               | anubhaga-decl
               | anugama-decl
               | aavaha-decl
               | sthiti-decl
               | "svasti"
               | "anaapta"

# ─── Step (pada) ──────────────────────────────────────────────────────────────

pada-decl    ::= "pada" identifier "{" pada-body "}"
pada-body    ::= karta-decl?
                 kaarya-decl?
                 aagama-decl?
                 nirgama-decl?
                 samaya-decl?
                 khanda-decl?
                 routing?

karta-decl      ::= "karta"      ":" identifier
kaarya-decl     ::= "kaarya"     ":" string
aagama-decl     ::= "aagama"     ":" typed-field ("," typed-field)*
nirgama-decl    ::= "nirgama"    ":" typed-field ("," typed-field)*
samaya-decl     ::= "samaya"     ":" number time-unit
khanda-decl     ::= "khanda"     ":" expression

routing         ::= pravritti-decl | prativritti-decl
pravritti-decl  ::= "pravritti"  ":" identifier
prativritti-decl ::= "prativritti" ":" identifier

# ─── Branching ────────────────────────────────────────────────────────────────

vibhaga-decl  ::= "vibhaga" identifier "{" niyama-clause+ "}"
niyama-clause ::= "niyama" expression "→" branch-target
branch-target ::= identifier | "svasti" | "anaapta"

# ─── Parallel ─────────────────────────────────────────────────────────────────

anubhaga-decl ::= "anubhaga" "{" flow-item+ "}" ("," "{" flow-item+ "}")+
anugama-decl  ::= "anugama"  identifier+

# ─── Sub-process ──────────────────────────────────────────────────────────────

aavaha-decl   ::= "aavaha" identifier
                  ("aagama" ":" typed-field ("," typed-field)*)?
                  ("nirgama" ":" typed-field ("," typed-field)*)?

# ─── State ────────────────────────────────────────────────────────────────────

sthiti-decl   ::= "sthiti" identifier

# ─── Variables ────────────────────────────────────────────────────────────────

varna-decl    ::= "varna" identifier ":" type ("=" expression)?

# ─── Type system ──────────────────────────────────────────────────────────────

typed-field  ::= "vikalpa"? identifier "(" type ")"

type         ::= scalar-type | collection-type
scalar-type  ::= "sankhya"
               | "bhinnaanka"
               | "dashaamsha"
               | "vakya"
               | "tithi"
               | "antara"
               | "tarka"
               | "patra"

collection-type ::= "krama" "[" type "]"
                  | "kosa"  "[" type "," type "]"

time-unit    ::= "antara" | "tithi"

# ─── Expressions ──────────────────────────────────────────────────────────────

expression   ::= tarka-value | identifier | comparison | logical
tarka-value  ::= "satya" | "asatya" | "avyakta"
comparison   ::= identifier operator literal
logical      ::= expression ("satya" | "asatya") expression
operator     ::= "=" | "≠" | ">" | "<" | "≥" | "≤"

# ─── Primitives ───────────────────────────────────────────────────────────────

identifier   ::= [a-zA-Z_][a-zA-Z0-9_-]*
string       ::= '"' [^"\n]* '"'
number       ::= [0-9]+ ("." [0-9]+)?
version      ::= [0-9]+ "." [0-9]+ "." [0-9]+
date         ::= [0-9]{4} "-" [0-9]{2} "-" [0-9]{2}
description  ::= string | identifier (identifier)*
literal      ::= string | number | date | tarka-value

# ─── Comments ─────────────────────────────────────────────────────────────────

comment      ::= "#" [^\n]* "\n"
