# Smriti Grammar Specification
# Version: 0.3
# This document is the language standard. The parser (src/parser.ts) implements it.
# Notation: EBNF — ? = optional, * = zero or more, + = one or more, | = or

# ─── Top level ────────────────────────────────────────────────────────────────

smriti-file  ::= (smriti-decl | sutra-decl)*

smriti-decl  ::= "smriti" identifier "{" smriti-body "}" iti?
sutra-decl   ::= "sutra"  identifier anuvrtti? "{" sutra-body "}" iti?

# smriti-body: strict ordering — metadata, I/O, references, participants, trigger, flow.
# pravah is optional — a smriti without pravah is a valid declaration-only block.
smriti-body  ::= metadata*
                 aagama-decl?
                 nirgama-decl?
                 reference*
                 participant*
                 trigger?
                 flow?

# sutra-body: aagama before pravah, nirgama after.
sutra-body   ::= metadata* aagama-decl? flow nirgama-decl?

# ─── Pāṇinian inheritance (anuvṛtti) ─────────────────────────────────────────

# Child sutra inherits parent's aagama, nirgama, and flow.
# aadesha steps in child replace named parent steps (Pāṇinian substitute).
anuvrtti     ::= "anuvrtti" name-ref

# ─── Pāṇinian close marker (iti) ─────────────────────────────────────────────

# Optional named-close marker — name must match the opening block name.
# Inspired by Pāṇini's use of 'iti' to end a quotation or rule boundary.
# Example: } iti passport-renewal
iti          ::= "iti" identifier

# ─── Metadata ─────────────────────────────────────────────────────────────────

metadata     ::= adhipati-decl
               | aavartana-decl
               | stara-decl
               | prabhaava-decl
               | sthala-decl
               | kshetra-decl
               | avadhi-decl

adhipati-decl   ::= "adhipati"  ":" string
aavartana-decl  ::= "aavartana" ":" version
stara-decl      ::= "stara"     ":" ("public" | "restricted" | "private")
prabhaava-decl  ::= "prabhaava" ":" date
sthala-decl     ::= "sthala"    ":" string
kshetra-decl    ::= "kshetra"   ":" string
avadhi-decl     ::= "avadhi"    ":" number "antara"

# ─── References ───────────────────────────────────────────────────────────────

reference    ::= sangama-decl | lagna-decl

# sangama: cross-file composition. yuja binds a file or registry URI to a namespace.
# Qualified names (namespace.member) are then valid wherever name-ref is accepted.
sangama-decl ::= "sangama" identifier "{" "yuja" ":" string "}" iti?

lagna-decl   ::= "lagna"   identifier "{" lagna-body "}" iti?
lagna-body   ::= ("yuja"      ":" string)
                 ("adhipati"  ":" string)?
                 ("aavartana" ":" version)?

# ─── Participants ─────────────────────────────────────────────────────────────

participant      ::= "paksha" identifier "{" participant-body "}" iti?
participant-body ::= bhumika-decl? adhikara-decl* pramana-decl?
bhumika-decl     ::= "bhumika"  ":" identifier
adhikara-decl    ::= "adhikara" ":" identifier ("," identifier)*
pramana-decl     ::= "pramana"  ":" string

# ─── Trigger ──────────────────────────────────────────────────────────────────

# ghatana is the event/condition that starts a process. All fields are optional.
# vrtti: boolean predicate — when true, the process fires. Identifiers must be aagama fields.
# hetu: schedule — prati N unit (user-defined unit: antara, day, submission, etc.)
# karta/sthala/kaarya: informational context — who/where/what. Identifiers unconstrained.

trigger      ::= "ghatana" "{" trigger-field* "}" iti?
trigger-field ::= vrtti-decl | hetu-decl | karta-field | sthala-field | kaarya-field

vrtti-decl   ::= "vrtti"  ":" expression
hetu-decl    ::= "hetu"   ":" "prati" number identifier
karta-field  ::= "karta"  ":" expression
sthala-field ::= "sthala" ":" expression
kaarya-field ::= "kaarya" ":" expression

# ─── Flow ─────────────────────────────────────────────────────────────────────

flow         ::= "pravah" "{" flow-item+ "}" iti?
flow-item    ::= pada-decl
               | aadesha-decl
               | varna-decl
               | vibhaga-decl
               | anubhaga-decl
               | anugama-decl
               | aavaha-decl
               | sthiti-decl
               | "svasti"
               | "anaapta"

# ─── Step (pada) ──────────────────────────────────────────────────────────────

# pada-body fields may appear in any order. Each is optional unless noted.
# apavaada → target: exception routing. apavaada: fields: data produced for the handler.
# samapti → target: SLA timeout routing (requires samaya). samapti: fields: timeout data.

pada-decl    ::= "pada" identifier "{" pada-body "}" iti?

# aadesha: replaces a named parent step's body (Pāṇinian substitute).
# The target name must exist in the parent sutra's flow.
aadesha-decl ::= "aadesha" identifier "{" pada-body "}"

pada-body    ::= karta-decl?
                 kaarya-decl?
                 aagama-decl?
                 nirgama-decl?
                 samaya-decl?
                 khanda-decl?
                 apavaada-decl?
                 apavaada-data?
                 samapti-decl?
                 samapti-data?
                 routing?

karta-decl      ::= "karta"      ":" name-ref
kaarya-decl     ::= "kaarya"     ":" string
aagama-decl     ::= "aagama"     ":" typed-field ("," typed-field)*
nirgama-decl    ::= "nirgama"    ":" typed-field ("," typed-field)*
samaya-decl     ::= "samaya"     ":" number time-unit
khanda-decl     ::= "khanda"     ":" expression

# apavaada → target : on exception/failure, route to this step or terminal
apavaada-decl   ::= "apavaada"   "→" (identifier | "svasti" | "anaapta")

# apavaada : fields : data produced when routing via apavaada (error data for handler)
apavaada-data   ::= "apavaada"   ":" typed-field ("," typed-field)*

# samapti → target : on SLA timeout, route to this step or terminal (requires samaya)
samapti-decl    ::= "samapti"    "→" (identifier | "svasti" | "anaapta")

# samapti : fields : data produced when routing via samapti (timeout data for handler)
samapti-data    ::= "samapti"    ":" typed-field ("," typed-field)*

routing         ::= pravritti-decl | prativritti-decl
pravritti-decl  ::= "pravritti"  ":" identifier
prativritti-decl ::= "prativritti" ":" identifier

# ─── varna (named variable / data binding) ────────────────────────────────────

# varna declares a named data binding in the flow. If expr is provided,
# the value is computed from existing produced fields. Without expr, it is
# an unbound typed slot (to be bound by runtime context).
# varna produces its name as a field available to subsequent flow items.

varna-decl   ::= "varna" identifier ":" type ("=" expression)?

# ─── Branching ────────────────────────────────────────────────────────────────

vibhaga-decl  ::= "vibhaga" identifier "{" niyama-clause+ "}" iti?
niyama-clause ::= "niyama" expression "→" branch-target
branch-target ::= identifier | "svasti" | "anaapta"

# ─── Parallel ─────────────────────────────────────────────────────────────────

anubhaga-decl ::= "anubhaga" "{" flow-item+ "}" ("," "{" flow-item+ "}")+
anugama-decl  ::= "anugama"  identifier+

# ─── Sub-process invocation ───────────────────────────────────────────────────

# aavaha invokes another process. target is a bare identifier (local step name)
# or a qualified name (imported process via sangama).
aavaha-decl   ::= "aavaha" name-ref
                  ("aagama" ":" typed-field ("," typed-field)*)?
                  ("nirgama" ":" typed-field ("," typed-field)*)?

# ─── State ────────────────────────────────────────────────────────────────────

sthiti-decl   ::= "sthiti" identifier

# ─── Name references ──────────────────────────────────────────────────────────

# name-ref is used wherever an actor or process target can be either a local
# identifier or a qualified name from an imported namespace (via sangama).
name-ref       ::= identifier | qualified-name
qualified-name ::= identifier "." identifier

# ─── Type system ──────────────────────────────────────────────────────────────

typed-field  ::= "vikalpa"? identifier "(" type ")"

# Types support constraints on scalar types and recursively on collection element types.
type         ::= scalar-type | collection-type

scalar-type  ::= "sankhya" range-constraint?   # integer, optional bounded range
               | "bhinnaanka"                  # fraction (1/3, 7/10)
               | "dashaamsha"                  # decimal (3.14, 0.5)
               | "vakya" string?               # text, optional regex pattern constraint
               | "tithi"                       # calendar date
               | "antara"                      # time span
               | "tarka"                       # boolean: satya | asatya | avyakta
               | "patra"                       # document/file reference

# range-constraint for sankhya: min..max | min.. | ..max
range-constraint ::= number ".." number?       # min..max or min..
                   | ".." number               # ..max

collection-type ::= "krama" "[" type "]"             # ordered list
                  | "kosa"  "[" type "," type "]"    # key-value map (key must be scalar)

time-unit    ::= "antara"

# ─── Expressions ──────────────────────────────────────────────────────────────

# Full recursive descent. Precedence low-to-high:
#   logical-or → logical-and → comparison → not → primary

expression   ::= logical-or

logical-or   ::= logical-and ("||" logical-and)*
logical-and  ::= comparison  ("&&" comparison)*
comparison   ::= not (compare-op not)?
not          ::= "!" not | primary
primary      ::= tarka-value | number | string | identifier | "(" expression ")"

compare-op   ::= "==" | "!=" | "<" | ">" | "<=" | ">="
tarka-value  ::= "satya" | "asatya" | "avyakta"

# ─── Primitives ───────────────────────────────────────────────────────────────

identifier   ::= [a-zA-Z_][a-zA-Z0-9_-]*
string       ::= '"' [^"\n]* '"'
number       ::= [0-9]+ ("." [0-9]+)?
version      ::= [0-9]+ "." [0-9]+ "." [0-9]+
date         ::= [0-9]{4} "-" [0-9]{2} "-" [0-9]{2}
literal      ::= string | number | date | tarka-value

# ─── Comments ─────────────────────────────────────────────────────────────────

comment      ::= "#" [^\n]* "\n"

# ─── Arrow notation ───────────────────────────────────────────────────────────

# "→" (U+2192) is the canonical arrow. ASCII "->" is accepted as an alias.
# Used in: niyama-clause, apavaada-decl, samapti-decl
