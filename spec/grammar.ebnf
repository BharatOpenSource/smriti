# Smriti Grammar Specification
# Version: 0.2
# This document is the language standard. The parser (src/parser.ts) implements it.
# Notation: EBNF — ? = optional, * = zero or more, + = one or more, | = or
# The parser treats pada-body fields as unordered (any sequence is valid).

# ─── Top level ────────────────────────────────────────────────────────────────

smriti-file  ::= (smriti-decl | sutra-decl)*

smriti-decl  ::= "smriti" identifier "{" smriti-body "}" iti?
sutra-decl   ::= "sutra"  identifier "{" sutra-body  "}" iti?

# smriti-body: metadata first, then process I/O, then references/participants, then flow.
# flow is optional — a smriti without pravah is a valid declaration-only block.
smriti-body  ::= metadata*
                 aagama-decl?
                 nirgama-decl?
                 reference*
                 participant*
                 trigger?
                 flow?

sutra-body   ::= metadata* aagama-decl? flow nirgama-decl?

# ─── Pāṇinian close marker (iti) ─────────────────────────────────────────────

# Optional named-close marker. If present, the name must match the opening block name.
# Inspired by Pāṇini's use of 'iti' to end a quotation or rule boundary.
# Example: } iti passport-renewal
iti          ::= "iti" identifier

# ─── Metadata ─────────────────────────────────────────────────────────────────

metadata     ::= adhipati-decl
               | aavartana-decl
               | stara-decl
               | prabhaava-decl
               | sthala-decl
               | kshetra-decl
               | avadhi-decl

adhipati-decl   ::= "adhipati"  ":" string
aavartana-decl  ::= "aavartana" ":" version
stara-decl      ::= "stara"     ":" ("public" | "restricted" | "private")
prabhaava-decl  ::= "prabhaava" ":" date
sthala-decl     ::= "sthala"    ":" string
kshetra-decl    ::= "kshetra"   ":" string
avadhi-decl     ::= "avadhi"    ":" number "antara"

# ─── References ───────────────────────────────────────────────────────────────

reference    ::= sangama-decl | lagna-decl

# sangama: cross-file composition. yuja binds a file or registry URI to a namespace.
# Qualified names (namespace.member) are then valid wherever name-ref is accepted.
sangama-decl ::= "sangama" identifier "{" "yuja" ":" string "}" iti?

lagna-decl   ::= "lagna"   identifier "{" lagna-body "}" iti?
lagna-body   ::= ("yuja"      ":" string)
                 ("adhipati"  ":" string)?
                 ("aavartana" ":" version)?

# ─── Participants ─────────────────────────────────────────────────────────────

participant      ::= "paksha" identifier "{" participant-body "}" iti?
participant-body ::= bhumika-decl? adhikara-decl* pramana-decl?
bhumika-decl     ::= "bhumika"  ":" identifier
adhikara-decl    ::= "adhikara" ":" identifier ("," identifier)*
pramana-decl     ::= "pramana"  ":" string

# ─── Trigger ──────────────────────────────────────────────────────────────────

trigger      ::= "ghatana" "{" trigger-body+ "}" iti?
trigger-body ::= vrtti-decl | hetu-decl
vrtti-decl   ::= "vrtti" ":" description
hetu-decl    ::= "hetu"  ":" description

# ─── Flow ─────────────────────────────────────────────────────────────────────

flow         ::= "pravah" "{" flow-item+ "}" iti?
flow-item    ::= pada-decl
               | vibhaga-decl
               | anubhaga-decl
               | anugama-decl
               | aavaha-decl
               | sthiti-decl
               | "svasti"
               | "anaapta"

# ─── Step (pada) ──────────────────────────────────────────────────────────────

# pada-body fields may appear in any order. Each is optional unless noted.
# apavaada requires a target step or terminal.
# samapti requires both a target step/terminal AND samaya on the same pada.

pada-decl    ::= "pada" identifier "{" pada-body "}" iti?
pada-body    ::= karta-decl?
                 kaarya-decl?
                 aagama-decl?
                 nirgama-decl?
                 samaya-decl?
                 khanda-decl?
                 apavaada-decl?
                 samapti-decl?
                 routing?

karta-decl      ::= "karta"      ":" name-ref
kaarya-decl     ::= "kaarya"     ":" string
aagama-decl     ::= "aagama"     ":" typed-field ("," typed-field)*
nirgama-decl    ::= "nirgama"    ":" typed-field ("," typed-field)*
samaya-decl     ::= "samaya"     ":" number time-unit
khanda-decl     ::= "khanda"     ":" expression

# apavaada: on exception/failure, route to this step or terminal
apavaada-decl   ::= "apavaada"   "→" (identifier | "svasti" | "anaapta")

# samapti: on SLA timeout, route to this step or terminal
# constraint: samaya must also be declared on this pada
samapti-decl    ::= "samapti"    "→" (identifier | "svasti" | "anaapta")

routing         ::= pravritti-decl | prativritti-decl
pravritti-decl  ::= "pravritti"  ":" identifier
prativritti-decl ::= "prativritti" ":" identifier

# ─── Branching ────────────────────────────────────────────────────────────────

vibhaga-decl  ::= "vibhaga" identifier "{" niyama-clause+ "}" iti?
niyama-clause ::= "niyama" expression "→" branch-target
branch-target ::= identifier | "svasti" | "anaapta"

# ─── Parallel ─────────────────────────────────────────────────────────────────

anubhaga-decl ::= "anubhaga" "{" flow-item+ "}" ("," "{" flow-item+ "}")+
anugama-decl  ::= "anugama"  identifier+

# ─── Sub-process invocation ───────────────────────────────────────────────────

# aavaha invokes another process. target is a bare identifier (local step name)
# or a qualified name (imported process via sangama).
aavaha-decl   ::= "aavaha" name-ref
                  ("aagama" ":" typed-field ("," typed-field)*)?
                  ("nirgama" ":" typed-field ("," typed-field)*)?

# ─── State ────────────────────────────────────────────────────────────────────

sthiti-decl   ::= "sthiti" identifier

# ─── Variables ────────────────────────────────────────────────────────────────

varna-decl    ::= "varna" identifier ":" type ("=" expression)?

# ─── Name references ──────────────────────────────────────────────────────────

# name-ref is used wherever an actor or process target can be either a local
# identifier or a qualified name from an imported namespace (via sangama).
name-ref       ::= identifier | qualified-name
qualified-name ::= identifier "." identifier

# ─── Type system ──────────────────────────────────────────────────────────────

typed-field  ::= "vikalpa"? identifier "(" type ")"

type         ::= scalar-type | collection-type
scalar-type  ::= "sankhya"
               | "bhinnaanka"
               | "dashaamsha"
               | "vakya"
               | "tithi"
               | "antara"
               | "tarka"
               | "patra"

collection-type ::= "krama" "[" type "]"
                  | "kosa"  "[" type "," type "]"

time-unit    ::= "antara"

# ─── Expressions ──────────────────────────────────────────────────────────────

# Full recursive descent. Precedence low-to-high:
#   logical-or → logical-and → comparison → not → primary

expression   ::= logical-or

logical-or   ::= logical-and ("||" logical-and)*
logical-and  ::= comparison  ("&&" comparison)*
comparison   ::= not (compare-op not)?
not          ::= "!" not | primary
primary      ::= tarka-value | number | string | identifier | "(" expression ")"

compare-op   ::= "==" | "!=" | "<" | ">" | "<=" | ">="
tarka-value  ::= "satya" | "asatya" | "avyakta"

# ─── Primitives ───────────────────────────────────────────────────────────────

identifier   ::= [a-zA-Z_][a-zA-Z0-9_-]*
string       ::= '"' [^"\n]* '"'
number       ::= [0-9]+ ("." [0-9]+)?
version      ::= [0-9]+ "." [0-9]+ "." [0-9]+
date         ::= [0-9]{4} "-" [0-9]{2} "-" [0-9]{2}
description  ::= string | identifier+
literal      ::= string | number | date | tarka-value

# ─── Comments ─────────────────────────────────────────────────────────────────

comment      ::= "#" [^\n]* "\n"

# ─── Arrow notation ───────────────────────────────────────────────────────────

# "→" (U+2192) is the canonical arrow. ASCII "->" is accepted as an alias.
# Used in: niyama-clause, apavaada-decl, samapti-decl
